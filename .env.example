TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id_here

# Reddit (optional - falls back to OAuth/public JSON when not set)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pain_finder/1.0

# Primary LLM provider (Codex/OpenAI-compatible by default)
LLM_PROVIDER=codex
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=gpt-5.3-spark
LLM_DEEP_DIVE_MODEL=
LLM_CLUSTER_MODEL=
LLM_GTM_MODEL=
LLM_MODEL_PRICING_JSON={}
LLM_REASONING_EFFORT=high
LLM_TEMPERATURE=1.0
LLM_MAX_TOKENS=16000

# Backward-compatible aliases still work if you already have them set:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_DEEP_DIVE_MODEL=
# OPENROUTER_CLUSTER_MODEL=
# OPENROUTER_GTM_MODEL=
# OPENROUTER_MODEL_PRICING_JSON={}

# Embeddings / dedup
# Runtime clustering uses this provider; use emergency_hash_bow only for deterministic offline fallback.
EMBED_PROVIDER=codex
EMBED_API_KEY=
EMBED_API_BASE=
EMBED_MODEL=text-embedding-3-small
DEDUP_SIMILARITY_THRESHOLD=0.88

DB_PATH=pain_finder.db
REPORTS_DIR=reports

CLASSIFIER_MODE=dual
CLASSIFIER_MAX_CONCURRENCY=8
SCREEN_MIN_RULE_SCORE=1
SCREEN_MAX_LLM_CANDIDATES_PER_RUN=0
LLM_MAX_CLASSIFICATIONS_PER_RUN=0
SEMANTIC_CANDIDATE_RETRIEVAL_ENABLED=1
SEMANTIC_CANDIDATE_MAX_PER_RUN=25
SEMANTIC_CANDIDATE_MAX_POOL=200
SEMANTIC_CANDIDATE_MIN_SIMILARITY=0.22
SEMANTIC_CANDIDATE_QUERIES_JSON=["manual workflow workaround causes repeated operational overhead", "reconcile payments invoices payouts between business systems", "tool sync integration failure export csv spreadsheet handoff"]
STAGED_PAIN_DETECTION_ENABLED=0
STAGED_EVIDENCE_EXTRACTION_ENABLED=0
MIN_CONFIDENCE_FOR_PROMOTION=0.55
PRIMARY_MAX_OUTPUT_TOKENS=1200
DEEP_DIVE_WTP_THRESHOLD=8
DEEP_DIVE_MAX_COMMENTS=250

SCRAPER_TOP_COMMENTS=5
SCRAPER_COMMENT_FETCH_CONCURRENCY=8
SCRAPER_RETRY_MAX_ATTEMPTS=5
SCRAPER_RETRY_BASE_DELAY=1.0
SCRAPER_FEED_MIX_JSON=["new", "rising", "top"]
SCRAPER_SEARCH_QUERIES_JSON=["manual process", "spreadsheet workaround", "any alternative"]

# Optional DSPy parser for primary Reddit pain parsing.
# Defaults inherit from the generic LLM provider above.
DSPY_REDDIT_PARSER_ENABLED=1
DSPY_PROVIDER=codex
DSPY_MODEL=gpt-5.3-spark
DSPY_REASONING_EFFORT=high
DSPY_API_KEY=
DSPY_API_BASE=
DSPY_TEMPERATURE=1.0
DSPY_MAX_TOKENS=16000

EXPORT_MIN_WTP=8
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_PREFIX=pain_finder

# Runtime / delivery mode
APP_MODE=telegram
DIGEST_DELIVERY_ENABLED=0
DIGEST_HOURS=24
DIGEST_GROUP_BY=niche
DIGEST_HOUR_UTC=9
DIGEST_MINUTE_UTC=0
DIGEST_MIN_WTP=8
DIGEST_MAX_ITEMS_PER_GROUP=10

DAILY_BUDGET_USD=2.0

TREND_LOOKBACK_DAYS=30
TREND_MIN_CLUSTER_SIZE=3
TREND_CLUSTER_SIMILARITY=0.72
MACRO_TREND_ENABLED=1
MACRO_TREND_WEEKDAY_UTC=sun
MACRO_TREND_HOUR_UTC=8

HN_ENABLED=0
HN_KEYWORDS_JSON=["internal tool", "frustrating", "we built our own", "manual process"]
HN_LOOKBACK_HOURS=72
HN_MAX_POSTS=100
HN_INTERVAL_HOURS=6

REVIEWS_ENABLED=0
REVIEW_TARGETS_JSON=[]
REVIEWS_MAX_PER_TARGET=30
REVIEWS_INTERVAL_HOURS=24

GTM_ENABLED=1
